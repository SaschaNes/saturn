[Unit]
Description=Saturn Samba coordinator (manual failover)
Wants=network-online.target
After=network-online.target etcd.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/lib/saturn/saturn.py run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
